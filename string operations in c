
#include <stdio.h>
#include <string.h>

int main()
{
    char str1[100], str2[100], temp[200];
    int choice;

    do
    {
        printf("\n----- STRING OPERATIONS -----");
        printf("\n1. Length of String");
        printf("\n2. Copy String");
        printf("\n3. Concatenate Strings");
        printf("\n4. Compare Strings");
        printf("\n5. Reverse String");
        printf("\n6. Exit");

        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                printf("Enter a string: ");
                scanf("%99s", str1);
                printf("Length = %lu", strlen(str1));
                break;

            case 2:
                printf("Enter a string: ");
                scanf("%99s", str1);
                strcpy(temp, str1);
                printf("Copied String = %s", temp);
                break;

            case 3:
                printf("Enter first string: ");
                scanf("%99s", str1);
                printf("Enter second string: ");
                scanf("%99s", str2);

                strcpy(temp, str1);
                strcat(temp, str2);

                printf("Concatenated String = %s", temp);
                break;

            case 4:
                printf("Enter first string: ");
                scanf("%99s", str1);
                printf("Enter second string: ");
                scanf("%99s", str2);

                if(strcmp(str1, str2) == 0)
                    printf("Strings are equal");
                else
                    printf("Strings are not equal");
                break;

            case 5:
                printf("Enter a string: ");
                scanf("%99s", str1);

                for(int i = 0, j = strlen(str1) - 1;
                    i < j; i++, j--)
                {
                    char ch = str1[i];
                    str1[i] = str1[j];
                    str1[j] = ch;
                }

                printf("Reversed String = %s", str1);
                break;

            case 6:
                printf("Exiting program...");
                break;

            default:
                printf("Invalid choice!");
        }

    } while(choice != 6);

    return 0;
}
